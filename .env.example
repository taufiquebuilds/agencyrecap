# Where you open the app. Must match the redirect URI in your Google OAuth client.
BASE_URL=http://localhost:8000
ADMIN_PASSWORD=change-me
# Make one with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change this after connecting Google, or the saved connection cannot be read.
APP_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Timezone for the 07:00 send job and for report months
TZ=Asia/Kolkata
# DATA_DIR=./data  # for local runs outside Docker

# Only if you put a reverse proxy (Caddy, nginx, Traefik) in front of the app:
# the proxy's IP address, so the login lockout sees each visitor's real IP.
# Use * only when the container can be reached through the proxy alone.
# FORWARDED_ALLOW_IPS=
